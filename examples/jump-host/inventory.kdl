vars {
    deploy-user "deploy"
}

// Every host goes through this bastion unless its group or the host itself names another.
jump "bastion.example.com" user="jumpuser"

group "internal" {
    host "app-1" "10.0.1.10" user="deploy"
    host "app-2" "10.0.1.11" user="deploy"

    host "app-3" "10.0.1.12" user="deploy" {
        jump "bastion-us.example.com" user="admin" port=2222
    }
}

host "db-backup" "10.0.2.50" user="root"

// Reachable directly: no bastion.
host "edge" "203.0.113.10" user="deploy" {
    jump #false
}
