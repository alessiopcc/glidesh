plan "container-app" {
    mode "sync"

    vars {
        app-image "nginx:alpine"
        app-port 8080
    }

    step "Deploy application" {
        container "webapp" {
            image "${app-image}"
            state "running"
            restart "always"
            ports {
                - "${app-port}:80"
            }
            environment {
                APP_ENV "production"
                LOG_LEVEL "info"
            }
            volumes {
                - "/data/webapp:/usr/share/nginx/html"
            }

            // The step does not finish until the app answers, so anything
            // subscribing to it can rely on the service being up.
            ready-cmd "curl -sf http://localhost:${app-port}"
            wait-timeout 60
        }
    }
}
