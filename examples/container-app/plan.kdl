plan "container-app" {
    mode "sync"

    vars {
        app-port 8080
    }

    // Asked when the run starts; `--var app-tag=1.27-alpine` answers it up front, and
    // without a terminal the default is used.
    vars-prompt {
        app-tag "nginx image tag to deploy" default="alpine"
    }

    step "Deploy application" {
        container "webapp" {
            image "nginx:${app-tag}"
            state "running"
            restart "always"
            ports {
                - "${app-port}:80"
            }
            environment {
                APP_ENV "production"
                LOG_LEVEL "info"
            }
            volumes {
                - "/data/webapp:/usr/share/nginx/html"
            }

            // The step does not finish until the app answers, so anything
            // subscribing to it can rely on the service being up.
            ready-cmd "curl -sf http://localhost:${app-port}"
            wait-timeout 60
        }
    }
}
