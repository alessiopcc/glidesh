plan "web-server" {
    mode "sync"

    vars {
        server-name "example.com"
        doc-root "/var/www/html"
    }

    step "Install nginx" tags="packages" {
        package "nginx" state="present"
    }

    // nginx -t stops a broken config before the restart below loads it. The rescue puts the
    // previous config back, then still fails the host: the change did not go out.
    step "Deploy nginx config" tags="config" {
        shell "cp -p /etc/nginx/sites-available/default /etc/nginx/default.previous" changed-when=#false
        file "/etc/nginx/sites-available/default" {
            src "files/nginx.conf"
            template #true
            owner "root"
            group "root"
            mode "0644"
        }
        shell "nginx -t" changed-when=#false
        rescue {
            shell "mv /etc/nginx/default.previous /etc/nginx/sites-available/default"
            shell "echo 'nginx -t rejected the new config; the previous one is back' >&2; exit 1"
        }
        always {
            shell "rm -f /etc/nginx/default.previous" changed-when=#false
        }
    }

    step "Start nginx" tags="service" {
        systemd "nginx" {
            state "started"
            enabled #true
        }
    }

    step "Restart nginx" subscribe="Deploy nginx config" tags="config" {
        systemd "nginx" state="restarted"
    }

    step "Health check" tags="config,service,check" {
        shell "curl -sf http://localhost/" {
            retries 5
            delay 2
        }
    }
}
