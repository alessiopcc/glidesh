plan "secrets-demo" {
    mode "sync"

    // db-password and api-token come from secrets.kdl (encrypted at rest).
    // glidesh decrypts them in memory and redacts them from all output.
    step "Use the database password" {
        shell "printf 'connecting with password: %s\\n' '${db-password}'"
    }

    step "Call an API with a token" {
        shell "printf 'Authorization: Bearer %s\\n' '${api-token}'"
    }
}
